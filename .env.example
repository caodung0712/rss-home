APIFY_MONTHLY_BUDGET_USD=5
APIFY_FB_ACTOR_ID=alfalfa~facebook-posts-scraper
APIFY_FB_CACHE_MINUTES=180
# Tuỳ chọn cũ (không còn bắt buộc):
APIFY_FB_TASK_ID=

# Reader UI
READER_UI_PASSWORD=
READER_UI_PORT=3000

# Sao lưu
BACKUP_DIR=./backups
