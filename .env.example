# Postgres / Miniflux
DB_PASSWORD=
MINIFLUX_ADMIN_USERNAME=admin
MINIFLUX_ADMIN_PASSWORD=
MINIFLUX_BASE_URL=http://localhost:8080
MINIFLUX_API_KEY=

# RSSHub / X / Facebook (tất cả đều tuỳ chọn - $0 miễn phí)
TWITTER_AUTH_TOKEN=
FACEBOOK_COOKIE=

# Apify (chỉ cần điền APIFY_TOKEN 1 lần nếu muốn dùng Apify cào Facebook theo link Page)
